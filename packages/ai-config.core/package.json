{
  "name": "@statewalker/ai-config.core",
  "version": "0.5.1",
  "private": false,
  "type": "module",
  "description": "Unified AI configuration: one workspace adapter for provider connections + discovered models + active selection. Credentials in Secrets; providers built directly from @ai-sdk. Shared by chat and wiki.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-config.core"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-config.core#readme",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fragment": {
      "source": "./src/fragment.ts",
      "types": "./dist/fragment.d.ts",
      "import": "./dist/fragment.js",
      "default": "./dist/fragment.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "tsdown"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@json-render/core": "catalog:",
    "ai": "catalog:",
    "@statewalker/shared-commands": "catalog:",
    "@statewalker/shared-registry": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/workspace.core": "catalog:"
  },
  "devDependencies": {
    "@statewalker/webrun-files-mem": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
