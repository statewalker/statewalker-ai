      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/ai-access": "workspace:^",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-rpc": "catalog:",
    "@statewalker/ai-environment": "workspace:^",
    "@statewalker/webrun-files-rpc": "catalog:",
    "@statewalker/webrun-msgpack": "catalog:",
    "@statewalker/webrun-streams-ws": "catalog:",
    "@statewalker/db-rpc": "catalog:",
    "@statewalker/db-api": "catalog:",
    "@statewalker/ai-memory": "workspace:^",
    "@statewalker/ai-tasks": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
