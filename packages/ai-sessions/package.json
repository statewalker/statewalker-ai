{
  "name": "@statewalker/ai-sessions",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Sessions: user and agent sessions, turns, items, summaries, the event log, and the session API as RPC methods.",
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-sessions#readme",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-sessions"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
