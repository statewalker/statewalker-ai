{
  // The harness's deployment: the Worker and its Durable Objects. The conformance suite starts it
  // on CellB Node in-process (packages/ai-conformance), with its vars overridden for the run.
  "name": "ai-host-do",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "ISSUER", "class_name": "Issuer" },
      { "name": "WORKSPACE", "class_name": "Workspace" },
      { "name": "USER", "class_name": "User" },
      { "name": "PROFILES", "class_name": "Profiles" },
      { "name": "AGENT", "class_name": "AgentSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Issuer", "Workspace", "AgentSession"] },
    { "tag": "v2", "new_sqlite_classes": ["User", "Profiles"] }
  ],
  "vars": {
    // The workspaces this deployment serves, comma-separated; the first is the default. A token
    // for any other workspace is refused.
    "WORKSPACES": "default",
    // The profiles file system's backend: "sql" (SqlFs on the Profiles DO's SQLite) or "memory".
    "PROFILES_BACKEND": "sql",
    // The role sources, asked in order: "file" (each project's access file, `.system/access`, with
    // custom roles in `.system/roles`; the workspace's admins in `/.system/access`) and "sql" (the
    // workspace's SQL). Each project is answered by the first source that knows it.
    "ROLE_SOURCES": "file",
    // Each workspace's store, one FilesApi whose first-level folders are its projects: "sql" (SqlFs
    // on the Workspace DO's SQLite), "memory", "local" (WORKSPACE_ROOT/<workspace>/, CellB Node and
    // CellD only) or "s3" (WORKSPACE_S3_BUCKET, optional WORKSPACE_S3_ENDPOINT, WORKSPACE_S3_REGION,
    // WORKSPACE_S3_PREFIX; keys below).
    "WORKSPACE_BACKEND": "sql",
    // The workspace's default ignore rules (gitignore syntax, one pattern per line), hiding files
    // from agent sessions and tool calls; each project's `.system/ignore` adds to them.
    "IGNORE": "",
    // Bytes per block of every file stream; each block is authorized again.
    "FILE_BLOCK_SIZE": "1048576",
    "TOKEN_TTL_MS": "3600000",
    // The deployment's plugin catalog: JSON {"<path>": "<text>"} of plugin sources, one folder per
    // plugin (Agent Plugins 1.0 or Claude Code layout). Workspaces add theirs in
    // `/.system/plugins/`, projects in `<project>/.system/plugins/`.
    "CATALOG": "{}",
    // The default agent, `<plugin>/<agent>`, for projects whose `.system/settings` names none.
    "DEFAULT_AGENT": "",
    // The deployment's model providers and models (statewalker/statewalker-root#134), JSON
    // {"providers": [{id, api, baseUrl, headers?, secret?}], "models": [{id: "<provider>/<model>",
    // alias?, contextWindow?, maxTokens?, input?, cost?}], "allow"?: [...], "default"?: "<id or alias>"}.
    // `api` is openai-completions, openai-responses, anthropic-messages or local; `secret` names a
    // secret bound to plugin "model-gateway" and the provider's host. Workspaces add theirs in
    // `/.system/models`, projects in `<project>/.system/models`, users through PUT /v1/me/models.
    // Without any configured model no session starts.
    "MODELS": "{}",
    // Optional: the deployment's permission rules, JSON {"allow": [...], "ask": [...], "deny": [...]},
    // entries "area.action[:target]" or "tool:<name>", applied in every project and mode beside each
    // project's `.system/permission-rules` and each user's `permission-rules` in their profile.
    //   PERMISSION_RULES = "{\"deny\": [\"files.write:/.git/**\"]}"
    // Optional: the deployment's own modes beside the built-in ones (default, acceptEdits, plan,
    // auto, bypassPermissions, dontAsk), JSON {name: {extends?, rules?, folders?, otherwise?, asks?}};
    // {"plan": {"extends": "plan", "folders": ["/docs/plans"]}} changes plan's folders.
    //   MODES = "{}"
    // How long a pending approval waits before it counts as denied, in ms (default 24 hours).
    "APPROVAL_TTL_MS": "86400000",
    // Compaction of long sessions into hierarchical summaries, JSON {budget_tokens?, tail_messages? |
    // tail_tokens?, group_size?, promote_threshold?, max_passes?, pin_tools?, trim_min_chars?}: the
    // context budget, the tail never compacted (by messages or by tokens), messages per depth-1
    // summary, same-depth summaries before promotion. "{}" keeps the defaults (100000 tokens, the
    // last 8 messages, 6, 4).
    "COMPACTION": "{}"
    // The S3 workspace backend's keys, set as runtime secrets, never vars:
    //   WORKSPACE_S3_ACCESS_KEY_ID, WORKSPACE_S3_SECRET_ACCESS_KEY
    // Secrets (statewalker/statewalker-root#133), set as runtime secrets, never vars:
    //   SECRETS_KEY          seals workspace, project and user secrets in each Workspace DO's SQLite
    //   DEPLOYMENT_SECRETS   {"NAME": {"plugins": [...], "hosts": [...]}}: the runtime secrets that are
    //                        deployment-level secrets, and their bindings (the values are the NAME secrets)
    // Test-only, never set in a real deployment:
    //   SSE_KEEPALIVE_MS     the event streams' keep-alive interval (30000 otherwise)
    //   USER_PROVIDER_HOSTS  hosts a user's own provider may use over http or at a private address
    //                        (comma-separated; a local scripted model)
    //   DEV_LOGIN = "true"   POST /v1/login {user, workspace?, ttlMs?} signs a token (stands in for an identity provider)
    //   ADMIN_KEY = "<key>"  the /admin/* routes, with "Authorization: Bearer <key>":
    //                        POST /admin/seed {files, workspace?} writes fixtures into a workspace
    //                        POST /admin/access {workspace?, project?, members?, roles?, workspaceRoles?}
    //                          writes the workspace's SQL role source
    //                        POST /admin/profiles {files} writes fixtures into the profiles file system
    //                        POST /admin/users/<user>/unreachable makes that User DO refuse every call
    //                        POST /admin/sessions/<id>/messages {content} runs a turn past the User DO
    //                          and answers it once it ended
    //                        POST /admin/users/<user>/revoke revokes a user everywhere, at the issuer (the operator's)
    //                        POST /admin/workspaces/<ws>/user-session {token} hands a token straight to that
    //                          workspace's DO, past the routing by the token's workspace
    //                        POST /admin/workspaces/<ws>/model-usage answers every model request the
    //                          workspace's budget recorded
    // Always on, the token issuer's routes: POST /v1/token {key} (a service account's API key for an
    // access token) and POST /v1/token/renew (a valid access token, as bearer, for a fresh one).
  }
}
