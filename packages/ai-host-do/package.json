{
  "name": "@statewalker/ai-host-do",
  "version": "0.0.0",
  "license": "MIT",
  "description": "The hosting layer: the Durable Object classes, REST and RPC entrypoints, and the bindings for CellB, CellD and Workers.",
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-host-do#readme",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-host-do"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js",
        "default": "./dist/browser.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/ai-access": "workspace:^",
    "@statewalker/ai-environment": "workspace:^",
    "@statewalker/ai-flue": "workspace:^",
    "@statewalker/ai-sessions": "workspace:^",
    "@statewalker/webrun-files": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@statewalker/db-sqlite-do": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-files-node": "catalog:",
    "@statewalker/webrun-files-s3": "catalog:",
    "@statewalker/webrun-files-sqlite": "catalog:",
    "@statewalker/webrun-files-rpc": "catalog:",
    "aws4fetch": "catalog:",
    "@statewalker/ai-definitions": "workspace:^",
    "@statewalker/webrun-files-composite": "catalog:",
    "@statewalker/db-rpc": "catalog:",
    "@statewalker/db-api": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@cloudflare/workers-types": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
