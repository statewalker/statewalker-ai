{
  "name": "@statewalker/ai-conformance",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "The harness's conformance suite: scenarios run against a live deployment through the session API, on every hosting runtime; and the threat-table check.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:nightly": "vitest run --config vitest.nightly.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p browser",
    "test:browser": "CONFORMANCE_RUNTIME=browser vitest run",
    "test:celld": "CONFORMANCE_RUNTIME=celld vitest run",
    "test:workerd": "CONFORMANCE_RUNTIME=workerd vitest run"
  },
  "devDependencies": {
    "@statewalker/ai-sessions": "workspace:^",
    "@statewalker/cellb": "catalog:",
    "@statewalker/webrun-biscuit": "catalog:",
    "@statewalker/webrun-rpc": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@statewalker/ai-environment": "workspace:^",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-rpc": "catalog:",
    "playwright": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:",
    "@statewalker/ai-host-do": "workspace:^",
    "ai": "catalog:",
    "zod": "catalog:",
    "openai": "catalog:",
    "@statewalker/ai-openai-compat": "workspace:^"
  }
}
