{
  "name": "@statewalker/ai-uhp-client",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Remote agent sessions: agent sessions whose core is an external harness behind a UHP server (Unified Harness Protocol 2026-10-19), working on copies of files whose changes return through the capability.",
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-uhp-client#readme",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-uhp-client"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@statewalker/ai-access": "workspace:^",
    "@statewalker/ai-environment": "workspace:^",
    "@statewalker/ai-sessions": "workspace:^",
    "@statewalker/webrun-files": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
