{
  "name": "@statewalker/ai-openai-compat.core",
  "version": "0.4.2",
  "license": "MIT",
  "description": "Wire-format adapter that exposes Vercel AI SDK provider instances over the OpenAI HTTP v1 API as a standard fetch handler. Transport-agnostic — no Hono / Express / Node http dependency.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-openai-compat.core"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-openai-compat.core#readme",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "src/**"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "build": "tsdown"
  },
  "dependencies": {
    "@ai-sdk/provider": "catalog:",
    "ai": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/openai": "catalog:",
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "openai": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
