{
  "name": "@statewalker/ai-tasks",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The per-project task queue: tasks under subjects, subscriptions with NATS-style filters, peek, take and leased claims with dead letters, reply inboxes, and the executor contract with a runner. The envelope carries no harness types.",
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-tasks#readme",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-tasks"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
