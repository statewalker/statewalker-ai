{
  "name": "@statewalker/ai-agent.core",
  "description": "Multi-turn AI agent library on the Vercel AI SDK: AgentRuntime, agents, persisted sessions, context shaping, tools, skills, MCP and model management.",
  "version": "0.4.2",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-agent.core#readme",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./state": {
      "source": "./src/state/index.ts",
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js",
      "default": "./dist/state/index.js"
    },
    "./models": {
      "source": "./src/models/index.ts",
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js",
      "default": "./dist/models/index.js"
    },
    "./runtime": {
      "source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./tools": {
      "source": "./src/tools/index.ts",
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist/**",
    "src/**"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/mcp": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@ai-sdk/provider-utils": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@statewalker/fsm": "catalog:",
    "@statewalker/shared-baseclass": "catalog:",
    "@statewalker/shared-ids": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-composite": "catalog:",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@statewalker/fsm-validator": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-agent.core"
  }
}
