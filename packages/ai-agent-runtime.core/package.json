{
  "name": "@statewalker/ai-agent-runtime.core",
  "version": "0.5.2",
  "private": false,
  "type": "module",
  "description": "AI agent-runtime fragment: AgentRuntimeAdapter, agent:tools slot, agent intents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-agent-runtime.core"
  },
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-agent-runtime.core#readme",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fragment": {
      "source": "./src/fragment.ts",
      "types": "./dist/fragment.d.ts",
      "import": "./dist/fragment.js",
      "default": "./dist/fragment.js"
    },
    "./internal/build-runtime": {
      "source": "./src/internal/build-runtime.ts",
      "types": "./dist/internal/build-runtime.d.ts",
      "import": "./dist/internal/build-runtime.js",
      "default": "./dist/internal/build-runtime.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
