{
  "name": "@statewalker/ai-environment",
  "version": "0.0.0",
  "license": "MIT",
  "description": "The environment contract: files, databases, search, exec, tools, model gateway, store and attenuate; the gated file view, executors, the model gateway and secrets.",
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-environment#readme",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-environment"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@statewalker/ai-access": "workspace:^",
    "@statewalker/db-api": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-files-rpc": "catalog:",
    "@statewalker/webrun-files-sqlite": "catalog:",
    "ignore": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@statewalker/db-sqlite-do": "catalog:",
    "fast-check": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
