{
  "name": "@statewalker/ai-environment",
  "version": "0.0.0",
  "license": "MIT",
  "description": "The environment contract: files, databases, search, exec, tools, model gateway, store and attenuate; the gated file view, executors, the model gateway and secrets.",
  "homepage": "https://github.com/statewalker/statewalker-ai/tree/main/packages/ai-environment#readme",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git",
    "directory": "packages/ai-environment"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./local-models": "./src/local-models.ts",
    "./webllm": "./src/webllm.ts",
    "./code-engines": "./src/code-engines.ts",
    "./pyodide": "./src/pyodide.ts",
    "./engines/pyodide-engine.mjs": "./engines/pyodide-engine.mjs",
    "./wasmer": "./src/wasmer.ts",
    "./engines/wasmer-engine.mjs": "./engines/wasmer-engine.mjs",
    "./engines/wasmer-fs-thread.mjs": "./engines/wasmer-fs-thread.mjs",
    "./engines/wasmer-preload.mjs": "./engines/wasmer-preload.mjs"
  },
  "files": [
    "dist",
    "engines",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./local-models": {
        "types": "./dist/local-models.d.ts",
        "import": "./dist/local-models.js",
        "default": "./dist/local-models.js"
      },
      "./webllm": {
        "types": "./dist/webllm.d.ts",
        "import": "./dist/webllm.js",
        "default": "./dist/webllm.js"
      },
      "./code-engines": {
        "types": "./dist/code-engines.d.ts",
        "import": "./dist/code-engines.js",
        "default": "./dist/code-engines.js"
      },
      "./pyodide": {
        "types": "./dist/pyodide.d.ts",
        "import": "./dist/pyodide.js",
        "default": "./dist/pyodide.js"
      },
      "./engines/pyodide-engine.mjs": "./engines/pyodide-engine.mjs",
      "./wasmer": {
        "types": "./dist/wasmer.d.ts",
        "import": "./dist/wasmer.js",
        "default": "./dist/wasmer.js"
      },
      "./engines/wasmer-engine.mjs": "./engines/wasmer-engine.mjs",
      "./engines/wasmer-fs-thread.mjs": "./engines/wasmer-fs-thread.mjs",
      "./engines/wasmer-preload.mjs": "./engines/wasmer-preload.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@statewalker/ai-access": "workspace:^",
    "@statewalker/db-api": "catalog:",
    "@statewalker/webrun-files": "catalog:",
    "@statewalker/webrun-files-mem": "catalog:",
    "@statewalker/webrun-files-rpc": "catalog:",
    "@statewalker/webrun-files-sqlite": "catalog:",
    "ignore": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@statewalker/db-sqlite-do": "catalog:",
    "fast-check": "catalog:"
  },
  "engines": {
    "node": ">=22.13"
  }
}
