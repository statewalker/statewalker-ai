{
  "name": "@statewalker/statewalker-ai-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "description": "The AI harness: agents over capability-filtered files and data on CellB, CellD and Cloudflare Workers.",
  "bugs": {
    "url": "https://github.com/statewalker/statewalker-ai/issues"
  },
  "homepage": "https://github.com/statewalker/statewalker-ai#readme",
  "author": {
    "name": "Mikhail Kotelnikov",
    "email": "mikhail.kotelnikov@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statewalker/statewalker-ai.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset",
    "test:nightly": "pnpm --filter @statewalker/ai-conformance run test:nightly",
    "test:mutation": "node packages/ai-conformance/src/nightly/mutate.ts packages/ai-conformance/mutations.json"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": ""
}
